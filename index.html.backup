        <option value="auto/cheap">Auto Cheap</option>
        <option value="pol/grok-4.6">Grok 4.6</option>
        <option value="pol/gpt-oss">GPT-OSS 120B</option>
        <option value="pol/kimi-k3">Kimi K3</option>
        <option value="pol/deepseek-pro">DeepSeek Pro</option>
        <option value="pol/gpt-5.6-luna">GPT-5.6 Luna</option>
        <option value="pol/glm-5.3">GLM 5.3</option>
        <option value="pol/llama">Llama</option>
        <option value="pol/command-a-plus">Command A+</option>
        <option value="gh/claude-opus-4.8">Claude Opus 4.8</option>
        <option value="gh/claude-sonnet-5">Claude Sonnet 5</option>
        <option value="gh/gpt-5.6-luna">GPT-5.6 Luna</option>
        <option value="gh/gpt-5.6-sol">GPT-5.6 Sol</option>
        <option value="gh/gemini-3.7-flash">Gemini 3.7 Flash</option>
        <option value="gh/kimi-k3">Kimi K3</option>
        <option value="oc/claude-sonnet-5">Claude Sonnet 5</option>
        <option value="oc/gpt-5.6-luna">GPT-5.6 Luna</option>
        <option value="oc/gpt-5.6-sol">GPT-5.6 Sol</option>
        <option value="oc/gemini-3.7-flash">Gemini 3.7 Flash</option>
        <option value="oc/kimi-k3">Kimi K3</option>
        <option value="oc/deepseek-v4-flash-free">DeepSeek V4 Flash (Free)</option>
        <option value="xai-oauth/grok-4.5">Grok 4.5</option>
        <option value="glm/glm-5.3">GLM 5.3</option>
        <option value="glm/glm-5.3-flash">GLM 5.3 Flash</option>
        <option value="glm/glm-5.2">GLM 5.2</option>
      </select>

      <div class="modelPicker" id="modelPicker">
        <button type="button" class="modelTrigger" id="modelTrigger">
          <span class="modelTriggerIcon" id="modelTriggerIcon">🧠</span>
