          </div>

          <div class="modelSection">
            <div class="modelSectionTitle">🚀 xAI & GLM</div>
            <button type="button" class="modelOption" data-value="xai-oauth/grok-4.5">
              <span class="modelOptIcon">🚀</span>
              <span class="modelOptContent">
                <span class="modelOptName">Grok 4.5</span>
                <span class="modelOptDesc">xAI OAuth · ✅ verified</span>
              </span>
            </button>
            <button type="button" class="modelOption" data-value="glm/glm-5.3">
              <span class="modelOptIcon">🎓</span>
              <span class="modelOptContent">
                <span class="modelOptName">GLM 5.3</span>
                <span class="modelOptDesc">Zhipu premium · ✅</span>
              </span>
            </button>
            <button type="button" class="modelOption" data-value="glm/glm-5.3-flash">
              <span class="modelOptIcon">⚡</span>
