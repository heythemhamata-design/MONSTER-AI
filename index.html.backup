              <span class="modelOptContent">
                <span class="modelOptName">GLM 5.2</span>
                <span class="modelOptDesc">Zhipu · ✅ verified</span>
              </span>
            </button>
          </div>

        </div>
      </div>

      <button class="icon danger" onclick="clearChat()" title="Clear conversation" aria-label="Clear">
        <svg viewBox="0 0 24 24">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </button>

      <button class="icon" onclick="cycleMode()" title="Switch model" aria-label="Switch">
        <svg viewBox="0 0 24 24">
          <polyline points="23 4 23 10 17 10"></polyline>
          <polyline points="1 20 1 14 7 14"></polyline>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
      </button>
    </div>
  </header>

  <section class="chatArea">
    <div class="messages" id="messages">
      <div class="hero">
        <div class="badge"><span class="onlineDot"></span> PRIVATE AI SYSTEM</div>
        <h1 id="heroTitle">I think, therefore I am.</h1>
        <p>A futuristic AI command center for your private AI workflow.</p>
        <div class="tags">
          <span class="tag">3D Space</span>
          <span class="tag">Streaming</span>
          <span class="tag">Vision</span>
          <span class="tag">Documents</span>
          <span class="tag">Local AI</span>
        </div>
      </div>

      <div class="message">
        <div class="avatar aiAvatar">AI</div>
        <div class="content">
          <div class="messageHead">MONSTER AI · Ready</div>
          <div class="bubble">
            Hello 👋<br><br>
            How can I assist you with your AI system, files, or automation today?
          </div>
          <button class="copy" onclick="copyBubble(this)">Copy</button>
        </div>
      </div>
    </div>

    <div class="composerLayer">
      <div class="composer">
        <div class="preview" id="preview"></div>
        <div class="composerMain">
          <input id="file" type="file" accept="*/*" multiple hidden onchange="handleFileSelection(event)">
          <button class="attach" onclick="document.getElementById('file').click()" title="Attach Files or Images">＋</button>
          <textarea id="input" rows="1" placeholder="Ask MONSTER AI anything or attach files..."></textarea>
          <button id="send" class="send" onclick="toggleSend()">Send</button>
        </div>
        <div class="composerMeta">
          <span>Enter to send · Shift + Enter newline</span>
          <span>OMNIROUTE AUTO</span>
        </div>
      </div>
    </div>
  </section>
</main>

<aside class="right glass">
  <div class="rightTitle">SYSTEM TELEMETRY</div>

  <div class="metric">
    <div class="metricName">Messages</div>
    <div class="metricValue" id="count">0</div>
    <div class="metricSub">Current session</div>
  </div>

  <div class="metric liveStats">
    <div class="metricName">Last Response</div>
    <div class="metricValue" id="lastResponse">—</div>
    <div class="metricSub" id="lastResponseLabel">Awaiting request</div>
  </div>

  <div class="metric liveStats">
    <div class="metricName">Avg Response</div>
    <div class="metricValue" id="avgResponse">—</div>
    <div class="metricSub">Session average</div>
  </div>

  <div class="metric liveStats">
    <div class="metricName">Tokens (est.)</div>
    <div class="metricValue" id="tokenCount">0</div>
    <div class="metricSub">Input + Output</div>
  </div>

  <div class="metric">
    <div class="metricName">Gateway</div>
    <div class="metricValue" style="color:var(--green)">ONLINE</div>
    <div class="metricSub">Connected</div>
  </div>

  <div class="metric">
    <div class="metricName">Model</div>
    <div class="metricValue" style="color:var(--cyan)" id="modelText">AUTO</div>
    <div class="metricSub">Dynamic routing</div>
  </div>
</aside>

</div>

<script>
const API = "/api";

const DEVELOPER_NAME_AR = "هيثم حماتة";
const DEVELOPER_NAME_EN = "Heythem Hamata";

function isDeveloperQuestion(text) {
  const value = String(text || "").toLowerCase().trim();
  const patterns = [
    /من صنعك/, /من الدي صنعك/, /من صانعك/, /من مطورك/, /من هو مطورك/,
    /شكون دارك/, /شكون صنعك/, /شكون طورك/, /شكون المبرمج ديالك/, /من برمجك/,
    /من انشاك/, /من أنشأك/, /من خلقك/, /صاحبك من/,
    /developer/, /your developer/, /who developed you/, /who created you/,
    /who made you/, /who built you/, /who is your developer/, /creator/,
    /created by/, /made by/
  ];
  return patterns.some(pattern => pattern.test(value));
}

function getDeveloperResponse() {
  return `
### MONSTER AI

أنا **MONSTER AI**، وتم تطويري بواسطة:

**${DEVELOPER_NAME_AR}**  
**${DEVELOPER_NAME_EN}**

⚡ Automation Engineer & AI Builder

أنا مصمم للعمل مع أنظمة الذكاء الاصطناعي، الأتمتة، APIs، workflows وواجهات AI الحديثة.
  `.trim();
}

let history = [];
let selectedFiles = [];
let controller = null;
let count = 0;
let heroTimer = null;

const input = document.getElementById("input");
const send = document.getElementById("send");
const messages = document.getElementById("messages");
const model = document.getElementById("model");

const modelPicker = document.getElementById("modelPicker");
const modelTrigger = document.getElementById("modelTrigger");
const modelPanel = document.getElementById("modelPanel");
const modelTriggerIcon = document.getElementById("modelTriggerIcon");
const modelTriggerName = document.getElementById("modelTriggerName");

if (typeof marked !== "undefined") {
  marked.setOptions({ gfm: true, breaks: true });
}

/* =========================================================
   MODEL METADATA
========================================================= */
const MODEL_META = {
  // ─── Auto ───
  "auto/smart":  { icon: "🧠", name: "Auto Smart" },
  "auto/coding": { icon: "💻", name: "Auto Coding" },
  "auto/fast":   { icon: "⚡", name: "Auto Fast" },
  "auto/cheap":  { icon: "💰", name: "Auto Cheap" },
  // ─── Pollinations ───
  "pol/grok-4.6":       { icon: "🚀", name: "Grok 4.6" },
  "pol/gpt-oss":        { icon: "🤖", name: "GPT-OSS 120B" },
  "pol/kimi-k3":        { icon: "🌟", name: "Kimi K3" },
  "pol/deepseek-pro":   { icon: "🧬", name: "DeepSeek Pro" },
  "pol/gpt-5.6-luna":   { icon: "🌙", name: "GPT-5.6 Luna" },
  "pol/glm-5.3":        { icon: "🎓", name: "GLM 5.3" },
  "pol/llama":          { icon: "🦙", name: "Llama" },
  "pol/command-a-plus": { icon: "⚡", name: "Command A+" },
  // ─── GitHub Copilot ───
  "gh/claude-opus-4.8": { icon: "👑", name: "Claude Opus 4.8" },
  "gh/claude-sonnet-5": { icon: "💠", name: "Claude Sonnet 5" },
  "gh/gpt-5.6-luna":    { icon: "🌙", name: "GPT-5.6 Luna" },
  "gh/gpt-5.6-sol":     { icon: "☀️", name: "GPT-5.6 Sol" },
  "gh/gemini-3.7-flash":{ icon: "💎", name: "Gemini 3.7 Flash" },
  "gh/kimi-k3":         { icon: "🌟", name: "Kimi K3" },
  // ─── OpenCode ───
  "oc/claude-sonnet-5":       { icon: "💠", name: "Claude Sonnet 5" },
  "oc/gpt-5.6-luna":          { icon: "🌙", name: "GPT-5.6 Luna" },
  "oc/gpt-5.6-sol":           { icon: "☀️", name: "GPT-5.6 Sol" },
  "oc/gemini-3.7-flash":      { icon: "💎", name: "Gemini 3.7 Flash" },
  "oc/kimi-k3":               { icon: "🌟", name: "Kimi K3" },
  "oc/deepseek-v4-flash-free":{ icon: "⚡", name: "DeepSeek V4 Flash (Free)" },
  // ─── xAI ───
  "xai-oauth/grok-4.5": { icon: "🚀", name: "Grok 4.5" },
  // ─── GLM ───
  "glm/glm-5.3":       { icon: "🎓", name: "GLM 5.3" },
  "glm/glm-5.3-flash": { icon: "⚡", name: "GLM 5.3 Flash" },
  "glm/glm-5.2":       { icon: "🎓", name: "GLM 5.2" },
};

const MODEL_LABELS = {
  "auto/smart":  "SMART",
  "auto/coding": "CODING",
  "auto/fast":   "FAST",
  "auto/cheap":  "CHEAP",
  "pol/grok-4.6":       "GROK 4.6",
  "pol/gpt-oss":        "GPT-OSS",
  "pol/kimi-k3":        "KIMI K3",
  "pol/deepseek-pro":   "DEEPSEEK PRO",
  "pol/gpt-5.6-luna":   "GPT-5.6 LUNA",
  "pol/glm-5.3":        "GLM 5.3",
  "pol/llama":          "LLAMA",
  "pol/command-a-plus": "COMMAND A+",
  "gh/claude-opus-4.8": "OPUS 4.8",
  "gh/claude-sonnet-5": "SONNET 5",
  "gh/gpt-5.6-luna":    "GPT-5.6 LUNA",
  "gh/gpt-5.6-sol":     "GPT-5.6 SOL",
  "gh/gemini-3.7-flash":"GEMINI 3.7",
  "gh/kimi-k3":         "KIMI K3",
  "oc/claude-sonnet-5": "SONNET 5",
  "oc/gpt-5.6-luna":    "GPT-5.6 LUNA",
  "oc/gpt-5.6-sol":     "GPT-5.6 SOL",
  "oc/gemini-3.7-flash":"GEMINI 3.7",
  "oc/kimi-k3":         "KIMI K3",
  "oc/deepseek-v4-flash-free": "DEEPSEEK FREE",
  "xai-oauth/grok-4.5": "GROK 4.5",
  "glm/glm-5.3":        "GLM 5.3",
  "glm/glm-5.3-flash":  "GLM 5.3 FLASH",
  "glm/glm-5.2":        "GLM 5.2",
};

/* =========================================================
   STATE
========================================================= */
const STORAGE_KEY = "monster_ai_preferred_model";
const stats = {
  responseTimes: [],
  totalTokens: 0
};

/* =========================================================
   MODEL PICKER
========================================================= */
function setModelValue(value, fireChange) {
  if (model) model.value = value;
  const meta = MODEL_META[value] || { icon: "🤖", name: value };
  if (modelTriggerIcon) modelTriggerIcon.textContent = meta.icon;
  if (modelTriggerName) modelTriggerName.textContent = meta.name;
  document.querySelectorAll(".modelOption").forEach(opt => {
    opt.classList.toggle("active", opt.dataset.value === value);
  });
  updateStats();
  if (fireChange && model) model.dispatchEvent(new Event("change"));
}

function openModelPanel() {
  modelPanel.classList.add("open");
  modelTrigger.classList.add("open");
}

function closeModelPanel() {
  modelPanel.classList.remove("open");
  modelTrigger.classList.remove("open");
}

if (modelTrigger && modelPanel) {
  modelTrigger.addEventListener("click", (e) => {
    e.stopPropagation();
    if (modelPanel.classList.contains("open")) closeModelPanel();
    else openModelPanel();
  });

  document.querySelectorAll(".modelOption").forEach(opt => {
    opt.addEventListener("click", (e) => {
      e.stopPropagation();
      setModelValue(opt.dataset.value, true);
      closeModelPanel();
    });
  });

  document.addEventListener("click", (e) => {
    if (!modelPicker.contains(e.target)) closeModelPanel();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModelPanel();
  });
}

/* =========================================================
   PREFERRED MODEL (localStorage)
========================================================= */
function savePreferredModel(value) {
  try {
    localStorage.setItem(STORAGE_KEY, value);
  } catch (e) { /* localStorage unavailable */ }
}

function loadPreferredModel() {
  try {
    return localStorage.getItem(STORAGE_KEY);
  } catch (e) {
    return null;
  }
}

/* =========================================================
   TOKENS ESTIMATION
========================================================= */
function estimateTokens(text) {
  if (!text) return 0;
  const str = String(text);
  const arabicChars = (str.match(/[\u0600-\u06FF]/g) || []).length;
  const otherChars = str.length - arabicChars;
  return Math.round(arabicChars / 2.5 + otherChars / 4);
}

/* =========================================================
   TOAST NOTIFICATION
========================================================= */
let toastTimer = null;
function showModelToast(meta) {
  let toast = document.getElementById("modelToast");
  if (!toast) {
    toast = document.createElement("div");
    toast.id = "modelToast";
    toast.className = "modelToast";
    document.body.appendChild(toast);
  }
  toast.textContent = `${meta.icon} ${meta.name} activated`;
  toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 1800);
}

/* =========================================================
   LIVE STATS
========================================================= */
function updateLiveStats() {
  const lastEl = document.getElementById("lastResponse");
  const avgEl = document.getElementById("avgResponse");
  const tokensEl = document.getElementById("tokenCount");
  const labelEl = document.getElementById("lastResponseLabel");

  if (lastEl && stats.responseTimes.length > 0) {
    lastEl.textContent = stats.responseTimes[stats.responseTimes.length - 1].toFixed(1) + "s";
  }
  if (avgEl && stats.responseTimes.length > 0) {
    const sum = stats.responseTimes.reduce((a, b) => a + b, 0);
    avgEl.textContent = (sum / stats.responseTimes.length).toFixed(1) + "s";
  }
  if (tokensEl) {
    tokensEl.textContent = stats.totalTokens.toLocaleString();
  }
  if (labelEl) {
    const n = stats.responseTimes.length;
    labelEl.textContent = n === 0 ? "Awaiting request" : `${n} response${n > 1 ? "s" : ""} tracked`;
  }
}

/* =========================================================
   PARTICLES
========================================================= */
const particleRoot = document.getElementById("particles");

function createParticles() {
  if (!particleRoot) return;
  particleRoot.innerHTML = "";
  const particleCount = Math.min(260, Math.max(130, Math.floor(window.innerWidth / 5)));
  for (let i = 0; i < particleCount; i++) {
    const p = document.createElement("div");
    p.className = "particle";
    const size = 1 + Math.random() * 4;
    const x = (Math.random() - 0.5) * 320;
    const y = (Math.random() - 0.5) * 260;
    const duration = 4 + Math.random() * 10;
    p.style.setProperty("--s", size + "px");
    p.style.setProperty("--x", x + "px");
    p.style.setProperty("--y", y + "px");
    p.style.setProperty("--d", duration + "s");
    p.style.left = Math.random() * 100 + "%";
    p.style.top = Math.random() * 100 + "%";
    p.style.animationDelay = -Math.random() * 8 + "s";
    particleRoot.appendChild(p);
  }
}
createParticles();
window.addEventListener("resize", createParticles);

/* =========================================================
   DYNAMIC HERO
========================================================= */
const heroMessages = {
  default: ["What can I help you with?", "Ready when you are.", "Let's make something happen.", "What are we building today?"],
  code: ["Let's build something.", "What are we coding today?", "Let's turn the idea into working code."],
  automation: ["Let's automate it.", "What should we automate today?", "Let's build the workflow."],
  trading: ["Let's analyze the market.", "What are we looking at?", "Let's make the next decision."],
  question: ["Let's figure it out.", "Tell me what you need.", "Let's find the answer."],
  image: ["Let's take a closer look.", "What should I analyze?", "Let me inspect these files."]
};

function getRandomItem(list) {
  return list[Math.floor(Math.random() * list.length)];
}

function detectHeroCategory(text) {
  const value = String(text || "").toLowerCase();
  if (selectedFiles.length > 0) return "image";
  if (/n8n|automation|webhook|workflow|zapier|make\.com/.test(value)) return "automation";
  if (/code|javascript|python|html|css|api|json|bug|function|script|node/.test(value)) return "code";
  if (/gold|xau|forex|trade|trading|market|buy|sell|signal|tp|sl/.test(value)) return "trading";
  if (/\?|how |why |what |when |where |can |could |should |help/.test(value)) return "question";
  return "default";
}

function updateHero(text = "", randomize = false) {
  const title = document.getElementById("heroTitle");
  if (!title) return;
  const category = randomize ? "default" : detectHeroCategory(text);
  const choices = heroMessages[category] || heroMessages.default;
  const next = getRandomItem(choices);
  if (title.textContent.trim() === next) return;
  title.style.opacity = "0";
  title.style.transform = "translateY(7px)";
  setTimeout(() => {
    const currentTitle = document.getElementById("heroTitle");
    if (!currentTitle) return;
    currentTitle.textContent = next;
    currentTitle.style.opacity = "1";
    currentTitle.style.transform = "translateY(0)";
  }, 140);
}

/* =========================================================
   FILE HANDLING
========================================================= */
async function handleFileSelection(event) {
  const files = Array.from(event.target.files || []);
  if (!files.length) return;
  for (const file of files) {
    try {
      if (file.type.startsWith("image/")) {
        const dataURL = await readFileAsDataURL(file);
        selectedFiles.push({ type: "image", name: file.name, data: dataURL });
      } else {
        const textContent = await readFileAsText(file);
        selectedFiles.push({ type: "text", name: file.name, data: textContent });
      }
    } catch (e) {
      console.error("Error reading file:", file.name, e);
    }
  }
  renderFilePreviews();
  updateHero("", false);
}

function readFileAsDataURL(file) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(r.result);
    r.onerror = () => reject(r.error);
    r.readAsDataURL(file);
  });
}

function readFileAsText(file) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(r.result);
    r.onerror = () => resolve(`[Binary or unreadable file: ${file.name}]`);
    r.readAsText(file);
  });
}

function renderFilePreviews() {
  const previewContainer = document.getElementById("preview");
  const visionStat = document.getElementById("sideVision");
  if (!selectedFiles.length) {
    previewContainer.style.display = "none";
    previewContainer.innerHTML = "";
    if (visionStat) { visionStat.textContent = "READY"; visionStat.style.color = ""; }
    return;
  }
  previewContainer.style.display = "flex";
  previewContainer.innerHTML = "";
  selectedFiles.forEach((item, index) => {
    const wrap = document.createElement("div");
    wrap.className = "previewWrap";
    if (item.type === "image") {
      const img = document.createElement("img");
      img.src = item.data;
      img.className = "previewImg";
      wrap.appendChild(img);
    } else {
      const badge = document.createElement("div");
      badge.className = "previewFile";
      badge.innerHTML = `📄 ${escapeHTML(item.name.length > 15 ? item.name.slice(0, 12) + "..." : item.name)}`;
      wrap.appendChild(badge);
    }
    const removeBtn = document.createElement("button");
    removeBtn.className = "remove";
    removeBtn.textContent = "×";
    removeBtn.onclick = () => removeSingleFile(index);
    wrap.appendChild(removeBtn);
    previewContainer.appendChild(wrap);
  });
  if (visionStat) {
    visionStat.textContent = "ACTIVE";
    visionStat.style.color = "var(--cyan)";
  }
}

function removeSingleFile(index) {
  selectedFiles.splice(index, 1);
  renderFilePreviews();
}

function removeAllFiles() {
  selectedFiles = [];
  document.getElementById("file").value = "";
  renderFilePreviews();
}

/* =========================================================
   MESSAGE CREATION
========================================================= */
function createMessage(type) {
  const row = document.createElement("div");
  row.className = "message " + (type === "user" ? "user" : "ai");

  const avatar = document.createElement("div");
  avatar.className = "avatar " + (type === "user" ? "youAvatar" : "aiAvatar");
  avatar.textContent = type === "user" ? "YOU" : "AI";

  const content = document.createElement("div");
  content.className = "content";

  const head = document.createElement("div");
  head.className = "messageHead";
  head.textContent = type === "user" ? "You · Now" : "MONSTER AI · AI";

  const bubble = document.createElement("div");
  bubble.className = "bubble";

  const copy = document.createElement("button");
  copy.className = "copy";
  copy.textContent = "Copy";
  copy.onclick = () => copyBubble(copy);

  content.appendChild(head);
  content.appendChild(bubble);
  content.appendChild(copy);

  if (type === "user") {
    row.appendChild(content);
    row.appendChild(avatar);
  } else {
    row.appendChild(avatar);
    row.appendChild(content);
  }
  messages.appendChild(row);
  scrollBottom();
  return bubble;
}

function handleLocalDeveloperResponse() {
  const t0 = performance.now();
  const response = getDeveloperResponse();
  const ai = createMessage("ai");
  ai.innerHTML = typeof marked !== "undefined" ? marked.parse(response) : escapeHTML(response);
  history.push({ role: "assistant", content: response });
  count++;

  // إحصائيات
  const elapsed = (performance.now() - t0) / 1000;
  stats.responseTimes.push(elapsed);
  if (stats.responseTimes.length > 50) stats.responseTimes.shift();
  stats.totalTokens += estimateTokens(response);

  updateStats();
  updateLiveStats();
  scrollBottom();
}

/* =========================================================
   SEND MESSAGE
========================================================= */
async function sendMessage() {
  const text = input.value.trim();
  const hasFiles = selectedFiles.length > 0;
  if (!text && !hasFiles) return;

  updateHero(text, false);
  const user = createMessage("user");

  if (!hasFiles && isDeveloperQuestion(text)) {
    const textEl = document.createElement("div");
    textEl.textContent = text;
    user.appendChild(textEl);
    history.push({ role: "user", content: text });
    count++;
    updateStats();
    input.value = "";
    resizeInput();
    handleLocalDeveloperResponse();
    input.focus();
    return;
  }

  const currentFiles = [...selectedFiles];

  currentFiles.forEach(file => {
    if (file.type === "image") {
      const img = document.createElement("img");
      img.src = file.data;
      img.className = "messageImg";
      user.appendChild(img);
    } else {
      const badge = document.createElement("div");
      badge.className = "fileBadge";
      badge.innerHTML = `📄 ${escapeHTML(file.name)}`;
      user.appendChild(badge);
    }
  });

  if (text) {
    const textEl = document.createElement("div");
    textEl.textContent = text;
    user.appendChild(textEl);
  }

  let payloadContent = [];
  if (text) payloadContent.push({ type: "text", text: text });

  currentFiles.forEach(file => {
    if (file.type === "image") {
      payloadContent.push({ type: "image_url", image_url: { url: file.data } });
    } else {
      payloadContent.push({ type: "text", text: `\n\n--- FILE: ${file.name} ---\n${file.data}\n--- END FILE ---\n` });
    }
  });

  const userMessagePayload = {
    role: "user",
    content: payloadContent.length === 1 && payloadContent[0].type === "text"
      ? payloadContent[0].text
      : payloadContent
  };

  history.push(userMessagePayload);
  count++;
  updateStats();
  removeAllFiles();
  input.value = "";
  resizeInput();

  send.textContent = "Stop";
  send.classList.add("stop");

  const streaming = document.getElementById("sideStreaming");
  if (streaming) {
    streaming.textContent = "ACTIVE";
    streaming.style.color = "var(--purple)";
  }

  const ai = createMessage("ai");
  const aiContent = ai.closest(".content");  // ← مرجع مباشر بدل :last-of-type
  ai.innerHTML = `
    <span class="thinking">
      <span class="thinkingLabel">Thinking</span>
      <span class="thinkingDots">
        <span></span><span></span><span></span>
      </span>
    </span>
  `;

  controller = new AbortController();
  const requestStart = performance.now();
  const inputTokens = estimateTokens(text);
  let success = false;

  try {
    const response = await fetch(API + "/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ model: model.value, messages: history, stream: true }),
      signal: controller.signal
    });

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(errorText || `HTTP ${response.status}`);
    }

    if (!response.body) throw new Error("Streaming response is unavailable.");

    const reader = response.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let buffer = "";
    let answer = "";

    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split("\n");
      buffer = lines.pop() || "";

      for (const line of lines) {
        const clean = line.trim();
        if (!clean || !clean.startsWith("data:")) continue;
        const raw = clean.slice(5).trim();
        if (raw === "[DONE]") continue;

        try {
          const json = JSON.parse(raw);
          if (json.__model_badge__) {
            updateModelBadge(ai, json.__model_badge__);
            scrollBottom();
            continue;
          }
          const delta = json?.choices?.[0]?.delta?.content;
          if (delta) {
            answer += delta;
            ai.innerHTML = typeof marked !== "undefined" ? marked.parse(answer) : escapeHTML(answer);
            scrollBottom();
          }
        } catch (e) { /* ignore partial SSE chunks */ }
      }
    }

    if (answer.trim()) {
      history.push({ role: "assistant", content: answer });
      count++;
      updateStats();
      success = true;
    }
  } catch (error) {
    if (error.name === "AbortError") {
      ai.innerHTML = `<span style="color:#677388;">Generation stopped.</span>`;
    } else {
      ai.innerHTML = `<span style="color:#ff687b;"><strong>ERROR:</strong><br><br>${escapeHTML(error.message)}</span>`;
    }
  } finally {
    if (success) {
      const elapsed = (performance.now() - requestStart) / 1000;
      const lastAI = history[history.length - 1];
      const outputTokens = estimateTokens(String(lastAI.content || ""));

      stats.responseTimes.push(elapsed);
      if (stats.responseTimes.length > 50) stats.responseTimes.shift();
      stats.totalTokens += inputTokens + outputTokens;

      updateLiveStats();

      // ✅ استخدام المرجع المباشر بدل :last-of-type
      if (aiContent) {
        const badge = aiContent.querySelector(".modelBadge");
        if (badge) {
          const oldInfo = badge.querySelector(".badgeInfo");
          if (oldInfo) oldInfo.remove();

          const info = document.createElement("span");
          info.className = "badgeInfo";
          info.textContent = `⚡ ${elapsed.toFixed(1)}s · ${outputTokens} tok`;
          badge.appendChild(info);
        }
      }
    }

    send.textContent = "Send";
    send.classList.remove("stop");
    controller = null;
    if (streaming) {
      streaming.textContent = "ON";
      streaming.style.color = "";
    }
    input.focus();
  }
}

/* =========================================================
   HELPERS
========================================================= */
function toggleSend() {
  if (controller) controller.abort();
  else sendMessage();
}

input.addEventListener("keydown", event => {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    if (!controller) sendMessage();
  }
});

input.addEventListener("input", () => {
  resizeInput();
  clearTimeout(heroTimer);
  const text = input.value.trim();
  heroTimer = setTimeout(() => { if (text) updateHero(text, false); }, 650);
});

function resizeInput() {
  if (!input) return;
  input.style.height = "auto";
  input.style.height = Math.min(input.scrollHeight, 150) + "px";
}

function scrollBottom() {
  if (!messages) return;
  messages.scrollTop = messages.scrollHeight;
}

async function copyBubble(button) {
  const bubble = button.closest(".content")?.querySelector(".bubble");
  if (!bubble) return;
  try {
    await navigator.clipboard.writeText(bubble.innerText);
    button.textContent = "Copied";
    setTimeout(() => { button.textContent = "Copy"; }, 1000);
  } catch (e) { console.error("Clipboard error:", e); }
}

function updateModelBadge(bubbleElement, modelName) {
  if (!bubbleElement) return;
  const content = bubbleElement.closest('.content');
  if (!content) return;
  let badge = content.querySelector('.modelBadge');
  if (!badge) {
    badge = document.createElement('div');
    badge.className = 'modelBadge';
    const copyBtn = content.querySelector('.copy');
    if (copyBtn) content.insertBefore(badge, copyBtn);
    else content.appendChild(badge);
  }
  const isFallback = modelName.toLowerCase().includes('fallback');
  badge.classList.toggle('fallback', isFallback);
  const icon = isFallback ? '⚠️' : '⚡';
  badge.textContent = `${icon} ${modelName}`;
  badge.title = `النموذج المستخدم: ${modelName}`;
}

function newChat() {
  if (controller) { controller.abort(); controller = null; }
  history = [];
  count = 0;
  updateStats();

  stats.responseTimes = [];
  stats.totalTokens = 0;
  updateLiveStats();

  messages.innerHTML = `
    <div class="hero">
      <div class="badge"><span class="onlineDot"></span> NEW PRIVATE SESSION</div>
      <h1 id="heroTitle">What can I help you with?</h1>
      <p>A futuristic AI command center for your private AI workflow.</p>
      <div class="tags">
        <span class="tag">3D Space</span>
        <span class="tag">Streaming</span>
        <span class="tag">Vision</span>
        <span class="tag">Documents</span>
        <span class="tag">Local AI</span>
      </div>
    </div>
    <div class="message">
      <div class="avatar aiAvatar">AI</div>
      <div class="content">
        <div class="messageHead">MONSTER AI · Ready</div>
        <div class="bubble">Hello 👋<br><br>How can I assist you with your AI system or files today?</div>
        <button class="copy" onclick="copyBubble(this)">Copy</button>
      </div>
    </div>
  `;
  removeAllFiles();
  input.value = "";
  resizeInput();
  input.focus();
}

function clearChat() {
  if (confirm("Clear this conversation?")) newChat();
}

function toggleSidebar() {
  const sidebar = document.getElementById("sidebar");
  if (sidebar) sidebar.classList.toggle("open");
}

function cycleMode() {
  const modes = [
    "auto/smart",
    "auto/fast",
    "pol/grok-4.6",
    "pol/gpt-oss",
    "pol/kimi-k3",
    "gh/claude-opus-4.8",
    "gh/gpt-5.6-sol",
    "oc/claude-sonnet-5",
    "oc/kimi-k3",
    "xai-oauth/grok-4.5",
    "glm/glm-5.3",
  ];
  const currentIndex = modes.indexOf(model.value);
  const nextIndex = (currentIndex + 1) % modes.length;
  setModelValue(modes[nextIndex], true);
  const title = document.getElementById("heroTitle");
  if (title) {
    title.style.transition = "color 0.3s";
    title.style.color = "var(--cyan)";
    setTimeout(() => { title.style.color = ""; }, 500);
  }
}

function updateStats() {
  const countEl = document.getElementById("count");
  if (countEl) countEl.textContent = count;
  const modelText = document.getElementById("modelText");
  if (modelText && model) {
    const selected = model.value;
    modelText.textContent = MODEL_LABELS[selected] || selected.toUpperCase();
  }
}

/* =========================================================
   MODEL CHANGE LISTENER
========================================================= */
if (model) {
  model.addEventListener("change", () => {
    updateStats();
    savePreferredModel(model.value);
    const meta = MODEL_META[model.value] || { icon: "🤖", name: model.value };
    showModelToast(meta);
  });
}

function escapeHTML(value) {
  const el = document.createElement("div");
  el.textContent = String(value);
  return el.innerHTML;
}

/* =========================================================
   INIT
========================================================= */
const savedModel = loadPreferredModel();
if (savedModel && MODEL_META[savedModel]) {
  setModelValue(savedModel, false);
} else {
  if (model) setModelValue(model.value, false);
}

updateStats();
resizeInput();
updateLiveStats();
</script>

</body>
</html>