@app.get("/api/conversations")
async def get_conversations():
    db = load_db()
    convs = list(db["conversations"].values())
    convs.sort(key=lambda x: x.get("updated_at", 0), reverse=True)
    return convs


@app.post("/api/conversations")
async def create_conversation():
    db = load_db()
    cid = str(uuid.uuid4())
    now = time.time()
    new_conv = {
        "id": cid, "title": "New Conversation", "messages": [],
        "created_at": now, "updated_at": now,
    }
    db["conversations"][cid] = new_conv
    save_db(db)
    return new_conv


@app.get("/api/conversations/{cid}")
async def get_conversation(cid: str):
    db = load_db()
    if cid not in db["conversations"]:
        raise HTTPException(status_code=404, detail="Conversation not found")
    return db["conversations"][cid]


@app.post("/api/conversations/{cid}/messages")
async def save_messages(cid: str, req: MessagesSaveModel):
    db = load_db()
    if cid not in db["conversations"]:
        raise HTTPException(status_code=404, detail="Conversation not found")
    conv = db["conversations"][cid]
    conv["messages"] = req.messages
    conv["updated_at"] = time.time()
    if req.messages and conv.get("title") in (None, "", "New Conversation"):
        title = extract_title_from_messages(req.messages)
        if title:
            conv["title"] = title[:30] + ("..." if len(title) > 30 else "")
    db["conversations"][cid] = conv
    save_db(db)
    return {"status": "success", "conversation": conv}


@app.delete("/api/conversations/{cid}")
async def delete_conversation(cid: str):
    db = load_db()
    if cid in db["conversations"]:
        del db["conversations"][cid]
        save_db(db)
        return {"status": "deleted", "id": cid}
    return {"status": "not_found", "id": cid}


# =========================================================
# FILES API
# =========================================================
@app.post("/api/files")
async def upload_file(file_req: FileUploadModel):
    extracted_text = ""
    if not file_req.mime_type.startswith("image/"):
        try:
            if "," in file_req.data:
                import base64
                b64_data = file_req.data.split(",", 1)[1]
                decoded_bytes = base64.b64decode(b64_data)
                extracted_text = decoded_bytes.decode("utf-8", errors="ignore")
        except Exception as e:
            extracted_text = f"[Could not parse file content: {str(e)}]"
    return {
        "filename": file_req.filename,
        "mime_type": file_req.mime_type,
        "extracted_text": extracted_text,
    }


# =========================================================
# PROVIDER CIRCUIT BREAKER
# =========================================================
PROVIDER_COOLDOWN_SECONDS = 300
_provider_cooldown: Dict[str, float] = {}


def _get_provider(model_id: str) -> str:
    return model_id.split("/", 1)[0] if "/" in model_id else model_id


def _provider_is_cooling(model_id: str) -> bool:
    prefix = _get_provider(model_id)
    until = _provider_cooldown.get(prefix, 0.0)
    return until > time.time()


def _cool_down_provider(model_id: str, seconds: int = PROVIDER_COOLDOWN_SECONDS):
    prefix = _get_provider(model_id)
    if _provider_cooldown.get(prefix, 0) < time.time() + seconds:
        _provider_cooldown[prefix] = time.time() + seconds
        print(f"{LOG_PREFIX} ðŸ§Š Provider '{prefix}' cooling down for {seconds}s", flush=True)


# =========================================================
# CATEGORY â†’ CHAIN RESOLVER
# =========================================================
def _resolve_chain(model_name: str) -> List[str]:
    """Use OmniRoute native routing first, then explicit fallbacks."""

    requested = (model_name or "").strip()

    native_routes = {
        "": "auto/smart",
        "auto": "auto/smart",
        "smart": "auto/smart",
        "auto/smart": "auto/smart",
        "coding": "auto/coding",
        "auto/coding": "auto/coding",
        "rapid": "auto/fast",
        "auto/fast": "auto/fast",
        "vision": "auto/vision",
        "auto/vision": "auto/vision",
    }

    route = native_routes.get(requested)

    if route:
        return [route] + [
            model for model in ULTIMATE_FALLBACKS
            if model != route
        ]

    if requested in SMART_CATEGORIES:
        chain = list(SMART_CATEGORIES[requested])

        for model in ULTIMATE_FALLBACKS:
            if model not in chain:
                chain.append(model)

        return chain

    chain = [requested]

    for model in FALLBACK_CHAINS.get(requested, []):
        if model not in chain:
            chain.append(model)

    for model in ULTIMATE_FALLBACKS:
        if model not in chain:
            chain.append(model)

    return chain    return [model_name] + [
        m for m in FALLBACK_CHAINS.get(model_name, [])
        if m != model_name
    ] + [m for m in ULTIMATE_FALLBACKS if m != model_name]


# =========================================================
# OMNIROUTE STREAMING ENGINE (OPTIMIZED)
# =========================================================
async def call_omniroute_stream(
    messages_history: list,
    model_name: str,
    _depth: int = 0,
    _tried: Optional[list] = None,
):
    if _tried is None:
        _tried = []

    payload_messages = [{"role": "system", "content": SYSTEM_INSTRUCTION}]
    for msg in messages_history:
        payload_messages.append({
            "role": msg.get("role", "user"),
            "content": msg.get("content", ""),
        })

    url = OMNIROUTE_BASE_URL.rstrip("/") + "/chat/completions"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {OMNIROUTE_API_KEY}",
        "Accept": "text/event-stream",
    }

    chain = _resolve_chain(model_name)
    if not chain:
        chain = [DEFAULT_MODEL]
    selected_model = chain[0]

    if _depth == 0:
        yield ("badge", selected_model)

    print(f"{LOG_PREFIX} 🎯 Trying: {selected_model} (depth={_depth})", flush=True)

    payload = {
        "model": selected_model,
        "messages": payload_messages,
        "stream": True,
    }

    fallback_needed = False
    fallback_reason = ""

    # تقليل المهلة إلى 90 ثانية بدلاً من 300 ليكون الانتقال للبديل أسرع
    timeout = httpx.Timeout(connect=10.0, read=90.0, write=30.0, pool=10.0)

    try:
        async with httpx.AsyncClient(timeout=timeout) as client:
            async with client.stream("POST", url, headers=headers, json=payload) as response:

                if response.status_code != 200:
                    err_content = await response.aread()
                    err_text = err_content.decode("utf-8", errors="ignore")
                    err_lower = err_text.lower()

                   if any(k in err_lower for k in (
    "credits",
    "top up",
    "quota",
    "payment required",
    "insufficient",
    "too many requests",
    "rate limit",
    "rate_limit",
    "resource_exhausted",
    "429",
)):
    _cool_down_provider(selected_model)l)
                        print(f"{LOG_PREFIX} Model '{selected_model}' unavailable (HTTP {response.status_code})", flush=True)
                    else:
                        raise Exception(f"OmniRoute HTTP {response.status_code}: {err_text[:500]}")

                                if not fallback_needed:
                    received_text = False

                    async for line in response.aiter_lines():
                        if not line or not line.startswith("data:"):
                            continue

                        raw_data = line[5:].strip()

                        if not raw_data:
                            continue

                        if raw_data == "[DONE]":
                            break

                        try:
                            json_data = json.loads(raw_data)
                        except json.JSONDecodeError:
                            continue

                        # Detect explicit upstream errors in SSE frames.
                        error_obj = json_data.get("error")

                        if error_obj:
                            err_text = json.dumps(
                                error_obj,
                                ensure_ascii=False,
                            )
                            err_lower = err_text.lower()

                            if any(
                                keyword in err_lower
                                for keyword in FALLBACK_KEYWORDS
                            ):
                                fallback_needed = True
                                fallback_reason = err_text[:200]

                                if any(keyword in err_lower for keyword in (
                                    "credits",
                                    "top up",
                                    "quota",
                                    "payment required",
                                    "insufficient",
                                    "too many requests",
                                    "rate limit",
                                    "rate_limit",
                                    "resource_exhausted",
                                    "429",
                                )):
                                    _cool_down_provider(selected_model)

                                print(
                                    f"{LOG_PREFIX} Streaming error from "
                                    f"'{selected_model}': {err_text[:200]}",
                                    flush=True,
                                )
                                break

                            raise Exception(
                                f"OmniRoute stream error for "
                                f"'{selected_model}': {err_text[:500]}"
                            )

                        # Report the actual selected model when OmniRoute
                        # includes it in the streaming response.
                        actual_model = json_data.get("model")

                        if (
                            _depth == 0
                            and actual_model
                            and actual_model != selected_model
                        ):
                            selected_model = actual_model
                            yield ("badge", actual_model)

                        choices = json_data.get("choices")

                        if not choices or not isinstance(choices, list):
                            continue

                        first = choices[0]

                        if not isinstance(first, dict):
                            continue

                        delta = first.get("delta") or {}

                        content = (
                            delta.get("content")
                            or delta.get("reasoning_content")
                            or delta.get("reasoning")
                            or delta.get("thinking")
                            or ""
                        )

                        if isinstance(content, list):
                            content = "".join(
                                part.get("text", "")
                                if isinstance(part, dict)
                                else str(part)
                                for part in content
                            )

                        if not content:
                            continue

                        lower_content = content.lower()

                        hidden_error = any(keyword in lower_content for keyword in (
                            "enough credits",
                            "top up",
                            "doesn't have enough",
                            "not your pollinations",
                            "quota",
                            "rate limit",
                            "rate-limit",
                            "rate_limit",
                            "rate_limit_exceeded",
                            "too many requests",
                            "resource_exhausted",
                            "payment required",
                            "insufficient",
                            "429",
                        ))

                        if hidden_error:
                            fallback_needed = True
                            fallback_reason = content[:200]
                            _cool_down_provider(selected_model)

                            print(
                                f"{LOG_PREFIX} Hidden streaming error from "
                                f"'{selected_model}': {content[:120]}",
                                flush=True,
                            )
                            break

                        received_text = True
                        yield ("text", content)

                    if received_text and not fallback_needed:
                        return

                    if not fallback_needed:
                        fallback_needed = True
                        fallback_reason = (
                            f"Empty response stream from '{selected_model}' "
                            f"(HTTP {response.status_code})"
                        )

                        print(
                            f"{LOG_PREFIX} {fallback_reason}",
                            flush=True,
                        )
                        if not line or not line.startswith("data:"):
                            continue
                        raw_data = line[5:].strip()
                        if not raw_data:
                            continue
                        if raw_data == "[DONE]":
                            break
                        try:
                            json_data = json.loads(raw_data)
                        except json.JSONDecodeError:
                            continue

                        choices = json_data.get("choices")
                        if not choices or not isinstance(choices, list):
                            continue
                        first = choices[0]
                        if not isinstance(first, dict):
                            continue

                        delta = first.get("delta") or {}
                        content = (
                            delta.get("content")
                            or delta.get("reasoning_content")
                            or delta.get("reasoning")
                            or delta.get("thinking")
                            or ""
                        )
                        if isinstance(content, list):
                            content = "".join(
                                p.get("text", "") if isinstance(p, dict) else str(p)
                                for p in content
                            )
                        if not content:
                            continue

                        _c_lower = content.lower()
                        _hidden = any(k in _c_lower for k in (
                            "enough credits", "top up",
                            "doesn't have enough", "not your pollinations",
                            "quota", "rate limit", "insufficient",
                            "payment required",
                        ))
                        if _hidden:
                            fallback_needed = True
                            fallback_reason = content[:200]
                            _cool_down_provider(selected_model)
                            print(f"{LOG_PREFIX} Hidden error in stream from '{selected_model}': {content[:120]}", flush=True)
                            break

                        yield ("text", content)
                    return

    except httpx.ConnectError as e:
        raise Exception(f"Cannot connect to OmniRoute at {OMNIROUTE_BASE_URL}. Is it running? ({e})")
    except httpx.ReadTimeout:
        fallback_needed = True
        fallback_reason = "Read Timeout (90s)"
        print(f"{LOG_PREFIX} Timeout for '{selected_model}', trying fallback...", flush=True)

    if not fallback_needed:
        return

    if _depth >= 5:
        raise Exception(f"Max fallback depth reached for '{model_name}'. Last: {fallback_reason}")

    if selected_model not in _tried:
        _tried.append(selected_model)

    next_candidates = [
        m for m in chain
        if m not in _tried and not _provider_is_cooling(m)
    ]
    if not next_candidates:
        next_candidates = [
            m for m in ULTIMATE_FALLBACKS
            if m not in _tried and not _provider_is_cooling(m)
        ]
    if not next_candidates:
        raise Exception(f"Exhausted all fallbacks for '{model_name}'. Tried: {_tried}. Cooldowns: {dict(_provider_cooldown)}")

    last_error = None
    for fallback_model in next_candidates:
        print(f"{LOG_PREFIX} [{_depth + 1}] '{selected_model}' -> fallback '{fallback_model}'", flush=True)
        yield ("badge", f"{fallback_model} (fallback)")
        try:
            async for item in call_omniroute_stream(messages_history, fallback_model, _depth + 1, _tried):
                if item[0] == "badge":
                    continue
                yield item
            return
        except Exception as e:
            last_error = e
            print(f"{LOG_PREFIX} Fallback '{fallback_model}' failed: {e}", flush=True)
            continue

    raise Exception(f"All fallbacks failed for '{model_name}'. Last: {last_error or fallback_reason}")


# =========================================================
# STREAM GENERATOR (OPTIMIZED - NO ARTIFICIAL DELAY)
# =========================================================
async def ai_stream_generator(cid: Optional[str], full_history: list, model_name: str):
    accumulated_text = ""
    try:
        async for item in call_omniroute_stream(full_history, model_name):
            kind, value = item
            if kind == "badge":
                yield ("data: " + json.dumps({"__model_badge__": value}, ensure_ascii=False) + "\n\n")
                continue
            if kind == "text":
                accumulated_text += value
                yield ("data: " + json.dumps({"choices": [{"delta": {"content": value}}]}, ensure_ascii=False) + "\n\n")
                # تم حذف asyncio.sleep(0.005) التي كانت تسبب البطء
    except Exception as e:
        print("=" * 68)
        print(f"{LOG_PREFIX} STREAM EXCEPTION:")
        traceback.print_exc()
        print("=" * 68)
        error_msg = f"[{type(e).__name__}]: {str(e)}"
        accumulated_text += "\n\n" + error_msg
        yield ("data: " + json.dumps({"choices": [{"delta": {"content": "\n\n" + error_msg}}]}, ensure_ascii=False) + "\n\n")

    yield "data: [DONE]\n\n"

    if cid and accumulated_text.strip():
        db = load_db()
        if cid in db["conversations"]:
            conv = db["conversations"][cid]
            full_history.append({"role": "assistant", "content": accumulated_text})
            conv["messages"] = full_history
            conv["updated_at"] = time.time()
            if conv.get("title") in (None, "", "New Conversation"):
                title = extract_title_from_messages(full_history)
                if title:
                    conv["title"] = title[:30] + ("..." if len(title) > 30 else "")
            db["conversations"][cid] = conv
            save_db(db)

# =========================================================
# CHAT ENDPOINT
# =========================================================
@app.post("/api/chat")
async def chat_endpoint(req: ChatRequestModel, request: Request):

    async def cancellable_stream():
        try:
            async for chunk in ai_stream_generator(
                req.conversation_id, req.messages, req.model,
            ):
                if await request.is_disconnected():
                    print(f"{LOG_PREFIX} Client disconnected - stopping stream", flush=True)
                    break
                yield chunk
        except asyncio.CancelledError:
            print(f"{LOG_PREFIX} Stream cancelled by client", flush=True)
            raise
        except Exception as e:
            print(f"{LOG_PREFIX} Unexpected chat stream error: {e}", flush=True)
            raise

    return StreamingResponse(
        cancellable_stream(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no",
        },
    )


